generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   // DIRECTOR | EDU_LEAD | ADMIN_LEAD | LECTURER
  createdAt    DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorName  String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  details    String   @default("")
  createdAt  DateTime @default(now())
}

model Group {
  id            String   @id @default(cuid())
  name          String   @unique
  courseName    String
  lecturerName  String
  lecturerEmail String?
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())

  students Student[]
  surveys  Survey[]
  issues   Issue[]
}

model Student {
  id      String @id @default(cuid())
  name    String
  email   String @unique
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  invites SurveyInvite[]
}

model Survey {
  id                    String   @id @default(cuid())
  title                 String
  waveNumber            Int      @default(1)
  groupId               String
  group                 Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheduledAt           DateTime
  closesAt              DateTime
  targetResponseRate    Int      @default(75) // percentage 1-100
  reminderIntervalHours Int      @default(24)
  status                String   @default("ACTIVE") // SCHEDULED | ACTIVE | CLOSED
  customQuestionsJson   String   @default("[]") // JSON array of CustomQuestion
  createdAt             DateTime @default(now())

  invites        SurveyInvite[]
  responses      Response[]
  analysis       SurveyAnalysis?
  reminderLogs   ReminderLog[]
  sourcedIssues  Issue[]         @relation("SourceSurvey")
  verifiedIssues Issue[]         @relation("VerifiedBySurvey")
}

model SurveyInvite {
  id             String    @id @default(cuid())
  surveyId       String
  survey         Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token          String    @unique
  respondedAt    DateTime?
  remindersSent  Int       @default(0)
  lastRemindedAt DateTime?

  @@unique([surveyId, studentId])
}

model Response {
  id                String   @id @default(cuid())
  surveyId          String
  survey            Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  lecturesScore     Int      // 1-5
  practiceScore     Int      // 1-5
  materialsScore    Int      // 1-5
  organizationScore Int      // 1-5
  comment           String   @default("")
  customAnswersJson String   @default("{}") // JSON map of questionId -> answer
  submittedAt       DateTime @default(now())
}

model SurveyAnalysis {
  id               String   @id @default(cuid())
  surveyId         String   @unique
  survey           Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  overallSummary   String
  themesJson       String   // JSON array of ThemeCluster
  dropsFlaggedJson String   // JSON array of DropFlag
  source           String   @default("FALLBACK") // GEMINI | FALLBACK
  analyzedAt       DateTime @default(now())
}

model Issue {
  id                 String    @id @default(cuid())
  title              String
  description        String
  category           String    // LECTURES | PRACTICE | MATERIALS | ORGANIZATION
  severity           String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status             String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | VERIFIED
  ownerRole          String    // EDU_LEAD | ADMIN_LEAD | DIRECTOR
  ownerName          String
  themeName          String?
  dueDate            DateTime
  groupId            String
  group              Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sourceSurveyId     String?
  sourceSurvey       Survey?   @relation("SourceSurvey", fields: [sourceSurveyId], references: [id], onDelete: SetNull)
  verifiedBySurveyId String?
  verifiedBySurvey   Survey?   @relation("VerifiedBySurvey", fields: [verifiedBySurveyId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
}

model ReminderLog {
  id           String   @id @default(cuid())
  surveyId     String
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  studentName  String
  studentEmail String
  channel      String   @default("EMAIL_SIMULATED")
  message      String
  sentAt       DateTime @default(now())
}
